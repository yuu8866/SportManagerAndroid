<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CCE5FF"
    android:orientation="vertical"
    tools:context="com.example.administrator.sportmanager.admin.qiantai_admin.collectActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D77F041D"
        android:gravity="center"
        android:padding="12dp"
        android:text="收藏信息"
        android:textSize="28sp"
        android:textColor="@color/white" />

    <!-- 社区收藏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="社区收藏"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#222222"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_collect_posts"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="6dp" />

    <!-- 器材收藏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="器材收藏"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#222222"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <ListView
            android:id="@+id/show_collect"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_person_collect_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80dp"
            android:layout_marginRight="80dp"
            android:text="返回"
            android:background="@drawable/bg_button_blue_gradient"
            android:textColor="@color/black" />
    </LinearLayout>

</LinearLayout>
