<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/adminUserDeleteTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        app:title="删除用户"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_media_previous" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_keyword"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="用户名/姓名/手机号"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@color/colorPrimary"
            android:text="搜索"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="#B0BEC5"
            android:text="重置"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/colorPrimary">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2"
            android:text="用户名" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
            android:text="密码" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1"
            android:text="姓名" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7"
            android:text="性别" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1"
            android:text="生日" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
            android:text="会员" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3"
            android:text="手机号" android:textColor="@android:color/white" android:textStyle="bold"
            android:gravity="center" android:textSize="12sp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/edit_reader_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="12dp"/>
</LinearLayout>
