<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <!-- 顶部栏 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_detail_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_detail_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="返回"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="帖子详情"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_collect_post"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="收藏"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 主内容卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_detail_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/card_detail_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- 作者信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_detail_avatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@android:drawable/sym_def_app_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginLeft="10dp">

                        <TextView
                            android:id="@+id/tv_detail_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="发帖人"
                            android:textColor="#222222"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_detail_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-01-01 12:00"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- 点赞按钮放右侧 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_like_post"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="点赞"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_like_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#444444"
                            android:textSize="12sp"
                            android:layout_marginLeft="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 标题 -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="标题"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginTop="12dp" />

                <!-- 正文 -->
                <TextView
                    android:id="@+id/tv_detail_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正文内容..."
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />

                <!-- 图片（无图隐藏） -->
                <ImageView
                    android:id="@+id/iv_detail_img"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="评论"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/et_comment"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:hint="说点什么吧…"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_send_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="发送"
                        android:textSize="13sp"
                        android:layout_marginLeft="10dp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lv_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:dividerHeight="6dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
