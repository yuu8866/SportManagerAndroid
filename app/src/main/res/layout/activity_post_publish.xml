<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_publish_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="发布帖子"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_publish"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_publish_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="标题"
                android:textStyle="bold"
                android:textColor="#444444"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_post_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:hint="请输入帖子标题（例如：减脂期怎么吃？）"
                android:padding="10dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正文内容"
                android:textStyle="bold"
                android:textColor="#444444"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

            <EditText
                android:id="@+id/et_post_content"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:hint="分享你的训练经验 / 食谱 / 器材推荐..."
                android:gravity="top"
                android:padding="10dp"
                android:textSize="14sp" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btn_publish_post"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="发布"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:background="#8B1E2D"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_publish"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/btn_publish_back"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="返回"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btn_publish_post"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
